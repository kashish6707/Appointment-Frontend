# URL of the Clinically backend (Appointment-Backend repo).
# Server-side only: the browser calls /api/* on this site and Next forwards it here.
# Set it before `npm run build`, because the forwarding rule is fixed at build time.
API_URL=http://localhost:4000

# Which side of the app this server shows: all (default), patient or doctor.
# patient: doctor pages return 404. doctor: every other page goes to /doctor/login.
APP_MODE=all

# true: patient pages use the sample data in lib/sampleData.ts instead of the backend.
NEXT_PUBLIC_USE_SAMPLE_DATA=false

# Live updates (Socket.IO). Empty: through this site's /api proxy (local development).
# On Vercel, set it to the backend's own address (e.g. https://clinically-api.onrender.com):
# Vercel can't forward WebSockets, so the browser connects to the backend directly.
NEXT_PUBLIC_REALTIME_URL=
